# Build Chatwoot from source using the project's own Dockerfile
# then add Railway-specific runtime (multirun, start script)

FROM docker/dockerfile:1 AS build
# The main build uses docker/Dockerfile which produces the final image
# We reference it via a separate build stage

# --- Use the existing multi-stage Dockerfile ---
FROM ruby:3.4.4-alpine3.21 AS pre-builder

ARG NODE_VERSION="24.13.0"
ARG PNPM_VERSION="10.2.0"
ENV NODE_VERSION=${NODE_VERSION} PNPM_VERSION=${PNPM_VERSION}
ARG BUNDLE_WITHOUT="development:test"
ENV BUNDLE_WITHOUT=${BUNDLE_WITHOUT} BUNDLER_VERSION=2.5.16
ARG RAILS_SERVE_STATIC_FILES=true
ENV RAILS_SERVE_STATIC_FILES=${RAILS_SERVE_STATIC_FILES}
ARG RAILS_ENV=production
ENV RAILS_ENV=${RAILS_ENV}
ARG NODE_OPTIONS="--max-old-space-size=4096 --openssl-legacy-provider"
ENV NODE_OPTIONS=${NODE_OPTIONS} BUNDLE_PATH="/gems"

RUN apk update && apk add --no-cache \
  openssl tar build-base tzdata postgresql-dev postgresql-client git curl xz \
  && gem install bundler -v "$BUNDLER_VERSION"

RUN apk add --no-cache nodejs npm \
  && npm install -g pnpm@${PNPM_VERSION}
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app
COPY Gemfile Gemfile.lock ./

RUN apk add --no-cache musl ruby-full ruby-dev gcc make musl-dev openssl-dev g++ linux-headers vips
RUN bundle config set --local force_ruby_platform true \
  && bundle config set without 'development test' \
  && bundle install -j 4 -r 3

COPY package.json pnpm-lock.yaml ./
RUN pnpm i

COPY . /app
RUN mkdir -p /app/log

RUN SECRET_KEY_BASE=precompile_placeholder RAILS_LOG_TO_STDOUT=enabled bundle exec rake assets:precompile \
  && rm -rf spec node_modules tmp/cache

RUN git rev-parse HEAD > /app/.git_sha 2>/dev/null || echo "unknown" > /app/.git_sha
RUN rm -rf /gems/ruby/3.4.0/cache/*.gem \
  && find /gems/ruby/3.4.0/gems/ \( -name "*.c" -o -name "*.o" \) -delete \
  && rm -rf .git .gitignore

# --- Final stage: production runtime with Railway extras ---
FROM ruby:3.4.4-alpine3.21

ENV BUNDLER_VERSION=2.5.16 RAILS_ENV=production RAILS_SERVE_STATIC_FILES=true
ENV BUNDLE_PATH="/gems" EXECJS_RUNTIME=Disabled BUNDLE_FORCE_RUBY_PLATFORM=1
ENV BUNDLE_WITHOUT="development:test"

RUN apk update && apk add --no-cache \
  build-base openssl tzdata postgresql-client imagemagick git vips multirun \
  && gem install bundler -v "$BUNDLER_VERSION"

RUN apk add --no-cache nodejs

COPY --from=pre-builder /gems/ /gems/
COPY --from=pre-builder /app /app
COPY --from=pre-builder /usr/local/bundle/ /usr/local/bundle/

WORKDIR /app

COPY --chmod=755 railway/start.sh ./start.sh

EXPOSE 3000

ENTRYPOINT ["/bin/sh"]
CMD ["start.sh"]
